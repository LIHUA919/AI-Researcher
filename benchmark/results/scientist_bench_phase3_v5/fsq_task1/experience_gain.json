    "goal": "Finite Scalar Quantization: VQ-VAE Made Simple",
    "metadata": {
      "instance_id": "fsq",
      "source_digest": "3d3a3451f4b0d9dac162263ac8c74c33c208853eb3fe5d439b1322e6585c8b8b",
